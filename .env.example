# SARA Database Configurations (Local Docker pgvector setup)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/sara_db

# SARA Redis Configurations (for Celery & Caching)
REDIS_URL=redis://redis:6379/0

# Security Configurations
JWT_SECRET=super_secret_jwt_key_change_me_in_production

# AI Services Integration
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed Web Origins (comma-separated list)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000